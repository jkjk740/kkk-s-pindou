HOST=127.0.0.1
PORT=3001
# Enable only behind a local proxy that overwrites forwarding headers.
TRUST_PROXY_LOOPBACK=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bead_island
DB_USER=bead_island_app
DB_PASSWORD=
WECHAT_APPID=wx0ebba69092706cc6
WECHAT_APP_SECRET=
SESSION_SECRET=
UPLOAD_DIR=./data/private-images
CUTOUT_AI_ENABLED=false
# aidge (default, paid cloud) or rembg (local backend/cutout-sidecar, loopback only).
CUTOUT_PROVIDER=aidge
CUTOUT_REMBG_URL=http://127.0.0.1:3101
CUTOUT_REMBG_TIMEOUT_MS=45000
CUTOUT_REMBG_QUEUE_LIMIT=4
CUTOUT_REMBG_HEALTH_INTERVAL_MS=15000
# Aidge RAM credentials; keep these in backend/.env only.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Private OSS staging bucket; objects only use douyu-cutout-tmp/.
CUTOUT_OSS_BUCKET=
CUTOUT_OSS_REGION=oss-cn-shanghai
# New mainland OSS accounts need a bound HTTPS custom domain for public access.
CUTOUT_OSS_ENDPOINT=
CUTOUT_OSS_CNAME=false
CUTOUT_DAILY_LIMIT=10
CUTOUT_QUEUE_LIMIT=8
