# Copy to /etc/douyu/rembg.env (root:root 0644, no secrets). Read by douyu-rembg.service.
REMBG_HOST=127.0.0.1
REMBG_PORT=3101
# Allowed: u2netp (production default on the 1.7 GiB ECS, peak ~0.3 GB), u2net (best quality,
# peak ~0.5 GB, needs >=1 GiB headroom), silueta. All Apache-2.0.
# Never use rembg's default bria-rmbg (CC BY-NC, non-commercial); the sidecar refuses it.
REMBG_MODEL=u2netp
# Pre-downloaded by deploy/aliyun/download-rembg-models.py; startup fails if missing or checksum differs.
U2NET_HOME=/opt/douyu-rembg/models
# onnxruntime intra-op threads. Memory is the same for 1 and 2 (measured); 2 is ~40% faster on u2netp.
# Use 1 if MySQL/Node latency suffers while a cutout runs on the 2 vCPU ECS.
REMBG_THREADS=2
REMBG_CONCURRENCY=1
REMBG_TIMEOUT_SECONDS=30
REMBG_QUEUE_WAIT_SECONDS=5
REMBG_MAX_INPUT_BYTES=8388608
REMBG_MAX_PIXELS=1048576
REMBG_MAX_SIDE=1024
# Memory tuning (defaults are the measured low-memory settings; leave as is under MemoryMax=600M).
REMBG_CPU_ARENA=false
REMBG_MEM_PATTERN=false
# extended: ~80 MB lower inference peak, ~20% slower, masks differ from rembg by at most 1/255.
# all: onnxruntime default, bit-identical to rembg 2.0.87, higher peak.
REMBG_GRAPH_OPT=extended
