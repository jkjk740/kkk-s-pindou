# Copy to /etc/douyu/backend.env on the server; keep real values out of Git/chat.
# The application must fail startup until the three required secrets are filled.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_LOOPBACK=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bead_island
DB_USER=bead_island_app
DB_PASSWORD=
WECHAT_APPID=wx0ebba69092706cc6
WECHAT_APP_SECRET=
# Generate a new production random secret with at least 32 bytes, no whitespace.
SESSION_SECRET=
UPLOAD_DIR=/var/lib/douyu/private-images

# Intelligent cutout switch. Turn on only after douyu-rembg.service reports /health ok.
CUTOUT_AI_ENABLED=false
# rembg = local U-2-Net sidecar on 127.0.0.1 (no cloud cost); aidge = paid Aidge ImageMatting below.
CUTOUT_PROVIDER=rembg
CUTOUT_REMBG_URL=http://127.0.0.1:3101
CUTOUT_REMBG_TIMEOUT_MS=45000
CUTOUT_REMBG_QUEUE_LIMIT=4
CUTOUT_REMBG_HEALTH_INTERVAL_MS=15000
# Aidge only (unused when CUTOUT_PROVIDER=rembg).
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
CUTOUT_OSS_BUCKET=
CUTOUT_OSS_REGION=oss-cn-shanghai
CUTOUT_OSS_ENDPOINT=
CUTOUT_OSS_CNAME=false
CUTOUT_DAILY_LIMIT=10
CUTOUT_QUEUE_LIMIT=8
