[Unit]
Description=Douyu cutout sidecar (U-2-Net on onnxruntime CPU, loopback only)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=douyu-rembg
Group=douyu-rembg
WorkingDirectory=/opt/douyu/current/backend/cutout-sidecar
EnvironmentFile=/etc/douyu/rembg.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/douyu-rembg/venv/bin/python /opt/douyu/current/backend/cutout-sidecar/server.py
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStartSec=120s
TimeoutStopSec=20s
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=douyu-rembg

# 不再导入 rembg/numba：u2netp 实测空闲 RSS 约 0.1 GB、推理峰值约 0.29–0.33 GB（含 5 个并发排队请求），
# u2net 峰值约 0.51 GB。MemoryHigh 让内核先回收页缓存；超过 MemoryMax 只杀本服务，由 Restart=always 拉起。
MemoryHigh=540M
MemoryMax=600M
MemorySwapMax=0
TasksMax=64
# 2 vCPU 机器上与 Node 共用 CPU；需要时可再加 CPUQuota=150%。

# 只允许本机通信：模型必须提前下载，运行时不能访问外网。
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
